# ============================================================================
# NgeTag Customer Web App — environment variables
# Copy to `.env.local` and fill in what you need. Everything is optional for
# the demo: without DATABASE_URL the app uses an in-memory store, and without
# OAuth credentials the Google/GitHub buttons fall back to a demo account.
# ============================================================================

# --- App ---------------------------------------------------------------------
# Canonical origin. Needed for stable OAuth redirect URIs behind proxies.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Postgres (optional) -----------------------------------------------------
# Enables real persistence for auth (customers/sessions) and telemetry
# (events, taste vectors, content embeddings). Requires the pgvector and
# postgis extensions — see docs/api-and-schema.md.
# DATABASE_URL=postgresql://user:password@localhost:5432/ngetag
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# --- Auth --------------------------------------------------------------------
# HS256 signing secret for access tokens. Generate with:
#   openssl rand -base64 48
# A development fallback is used when unset (never do this in production).
AUTH_JWT_SECRET=

# Seed the demo customer (demo@ngetag.id / ngetag123) in in-memory mode.
AUTH_SEED_DEMO=true

# Development convenience: mark email/password signups as verified.
# Set to false to require a verification flow.
AUTH_AUTO_VERIFY_EMAIL=true

# Allow OAuth buttons to simulate a provider login when credentials are unset.
AUTH_ALLOW_DEMO_OAUTH=true

# --- OAuth providers (optional) ---------------------------------------------
# Leave empty to use the demo OAuth flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Telemetry ---------------------------------------------------------------
# Set to true to disable the client SDK entirely (also honours DNT).
NEXT_PUBLIC_TELEMETRY_DISABLED=false

# Machine token for cron/CI access to /api/telemetry/flush and /reindex.
TELEMETRY_FLUSH_TOKEN=
